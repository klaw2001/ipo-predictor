# Database (Docker internal — do not change unless running outside Docker)
DATABASE_URL="postgresql://ipo_user:ipo_pass@postgres:5432/ipo_db"

# ML Service (Docker internal — do not change unless running outside Docker)
ML_SERVICE_URL="http://ml-service:8000"
ML_SERVICE_API_KEY="change-me-ml-secret"

# Admin API (for manual scrape triggers) — change this in production!
ADMIN_API_KEY="change-me-admin-secret"

# Public app URL
NEXT_PUBLIC_APP_URL="https://ipopredictor.in"

# Timezone (IMPORTANT: must be set for correct cron scheduling)
TZ="Asia/Kolkata"
